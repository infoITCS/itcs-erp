  height                Decimal       @default(0) @db.Decimal(19, 4)
  dimensionUnit         String        @default("METER") @map("dimension_unit") @db.VarChar(16)
  cogsAccount           String        @default("COGS - Products (50110)") @map("cogs_account") @db.VarChar(120)
  incomeAccount         String        @default("Sales - Miscellaneous (40150)") @map("income_account") @db.VarChar(120)
  notes                 String?       @db.VarChar(4000)
  createdById           String        @map("created_by_id") @db.Uuid
  updatedById     String        @map("updated_by_id") @db.Uuid
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization                 @relation(fields: [organizationId], references: [id])
  category             ProductCategory?             @relation(fields: [categoryId], references: [id])
  unitOfMeasure        UnitOfMeasure                @relation(fields: [unitOfMeasureId], references: [id])
  taxCode              TaxCode?                     @relation(fields: [taxCodeId], references: [id])
  createdBy            User                         @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy            User                         @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  prices               ProductPrice[]
  opportunityInterests OpportunityProductInterest[]
  quoteLines           QuoteLine[]
  salesOrderLines      SalesOrderLine[]
  invoiceLines         InvoiceLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  vendorBillLines      VendorBillLine[]
  inventoryMovements   InventoryMovement[]
  inventoryBalances    InventoryBalance[]

  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, productType, createdAt])
  @@index([organizationId, categoryId, createdAt])
  @@index([organizationId, trackInventory])
  @@map("products")
}

model ProductPrice {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  productId      String           @map("product_id") @db.Uuid
  priceType      ProductPriceType @map("price_type")
  priceListCode  String           @default("STANDARD") @map("price_list_code") @db.VarChar(32)
  currencyCode   String           @map("currency_code") @db.Char(3)
  amount         Decimal          @db.Decimal(19, 4)
  effectiveDate  DateTime         @map("effective_date") @db.Date
  expiryDate     DateTime?        @map("expiry_date") @db.Date
  isActive       Boolean          @default(true) @map("is_active")
  createdById    String           @map("created_by_id") @db.Uuid
  updatedById    String           @map("updated_by_id") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  currency     Currency     @relation(fields: [currencyCode], references: [code])
  createdBy    User         @relation("PriceCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("PriceUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId, productId, priceType, effectiveDate])
  @@index([organizationId, priceListCode, currencyCode])
  @@map("product_prices")
}

/// Formal bid or tender submitted to a customer. The buyer's own reference is
/// kept separately from the internal TND document number.
model Tender {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  tenderNumber       String       @map("tender_number") @db.VarChar(32)
  title              String       @db.VarChar(200)
  description        String?      @db.VarChar(4000)
  referenceNumber    String?      @map("reference_number") @db.VarChar(120)
  status             TenderStatus @default(DRAFT)
  customerId         String       @map("customer_id") @db.Uuid
  contactId          String?      @map("contact_id") @db.Uuid
  ownerUserId        String       @map("owner_user_id") @db.Uuid
  estimatedValue     Decimal      @default(0) @map("estimated_value") @db.Decimal(19, 4)
  currencyCode       String       @map("currency_code") @db.Char(3)
  exchangeRateToBase Decimal?     @map("exchange_rate_to_base") @db.Decimal(19, 8)
  estimatedValueBase Decimal?     @map("estimated_value_base") @db.Decimal(19, 4)
  baseCurrencyCode   String?      @map("base_currency_code") @db.Char(3)
  submissionDeadline DateTime?    @map("submission_deadline") @db.Timestamptz(6)
  expectedAwardDate  DateTime?    @map("expected_award_date") @db.Date
  notes              String?      @db.VarChar(4000)
  createdById        String       @map("created_by_id") @db.Uuid
  updatedById        String       @map("updated_by_id") @db.Uuid
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        User         @relation("TenderOwner", fields: [ownerUserId], references: [id])
  currency     Currency     @relation(fields: [currencyCode], references: [code])
  createdBy    User         @relation("TenderCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("TenderUpdatedBy", fields: [updatedById], references: [id])
  opportunity  Opportunity?

  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, submissionDeadline])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, submissionDeadline])
  @@map("tenders")
}

/// Early-stage enquiry. A qualified lead converts into a customer account,
/// contact, and opportunity; the conversion keeps the original lead reference.
model Lead {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  leadNumber          String             @map("lead_number") @db.VarChar(32)
  firstName           String             @map("first_name") @db.VarChar(100)
  lastName            String             @map("last_name") @db.VarChar(100)
  displayName         String             @map("display_name") @db.VarChar(200)
  companyName         String?            @map("company_name") @db.VarChar(200)
  jobTitle            String?            @map("job_title") @db.VarChar(120)
  email               String?            @db.VarChar(320)
  phone               String?            @db.VarChar(40)
  website             String?            @db.VarChar(200)
  countryCode         String             @map("country_code") @db.Char(2)
  currencyCode        String             @map("currency_code") @db.Char(3)
  source              CustomerLeadSource @map("source")
  status              LeadStatus         @default(NEW)
  priority            CustomerPriority   @default(NORMAL)
  estimatedValue      Decimal            @default(0) @map("estimated_value") @db.Decimal(19, 4)
  ownerUserId         String             @map("owner_user_id") @db.Uuid
  nextAction          String?            @map("next_action") @db.VarChar(500)
  nextActionDueAt     DateTime?          @map("next_action_due_at") @db.Timestamptz(6)
  description         String?            @db.VarChar(4000)
  notes               String?            @db.VarChar(4000)
  qualifiedAt         DateTime?          @map("qualified_at") @db.Timestamptz(6)
  unqualifiedAt       DateTime?          @map("unqualified_at") @db.Timestamptz(6)
  unqualifiedReason   String?            @map("unqualified_reason") @db.VarChar(500)
  convertedAt         DateTime?          @map("converted_at") @db.Timestamptz(6)
  wonAt               DateTime?          @map("won_at") @db.Timestamptz(6)
  convertedCustomerId String?            @map("converted_customer_id") @db.Uuid
  convertedContactId  String?            @map("converted_contact_id") @db.Uuid
  createdById         String             @map("created_by_id") @db.Uuid
  updatedById         String             @map("updated_by_id") @db.Uuid
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization @relation(fields: [organizationId], references: [id])
  currency          Currency     @relation(fields: [currencyCode], references: [code])
  owner             User         @relation("LeadOwner", fields: [ownerUserId], references: [id])
  convertedCustomer Customer?    @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedContact  Contact?     @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  createdBy         User         @relation("LeadCreatedBy", fields: [createdById], references: [id])
  updatedBy         User         @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  opportunity       Opportunity?

  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, source, createdAt])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, email])
  @@index([organizationId, nextActionDueAt])
  @@map("leads")
}

/// CRM pipeline record. Prospects live here until converted to a Customer.
model Opportunity {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  opportunityNumber   String                 @map("opportunity_number") @db.VarChar(32)
  title               String                 @db.VarChar(200)
  description         String?                @db.VarChar(4000)
  stage               OpportunityStage       @default(NEW)
  customerId          String?                @map("customer_id") @db.Uuid
  contactId           String?                @map("contact_id") @db.Uuid
  resellerId          String?                @map("reseller_id") @db.Uuid
  leadId              String?                @unique @map("lead_id") @db.Uuid
  tenderId            String?                @unique @map("tender_id") @db.Uuid
  ownerUserId         String                 @map("owner_user_id") @db.Uuid
  leadSource          CustomerLeadSource?    @map("lead_source")
  estimatedValue      Decimal                @default(0) @map("estimated_value") @db.Decimal(19, 4)
  currencyCode        String                 @map("currency_code") @db.Char(3)
  exchangeRateToBase  Decimal?               @map("exchange_rate_to_base") @db.Decimal(19, 8)
  estimatedValueBase  Decimal?               @map("estimated_value_base") @db.Decimal(19, 4)
  baseCurrencyCode    String?                @map("base_currency_code") @db.Char(3)
  probabilityPercent  Int                    @default(10) @map("probability_percent")
  expectedCloseDate   DateTime?              @map("expected_close_date") @db.Date
  nextAction          String?                @map("next_action") @db.VarChar(500)
  nextActionDueAt     DateTime?              @map("next_action_due_at") @db.Timestamptz(6)
  lostReason          OpportunityLostReason? @map("lost_reason")
  lostReasonDetail    String?                @map("lost_reason_detail") @db.VarChar(500)
  competitorName      String?                @map("competitor_name") @db.VarChar(200)
  wonAt               DateTime?              @map("won_at") @db.Timestamptz(6)
  lostAt              DateTime?              @map("lost_at") @db.Timestamptz(6)
  closedAt            DateTime?              @map("closed_at") @db.Timestamptz(6)
  reopenedAt          DateTime?              @map("reopened_at") @db.Timestamptz(6)
  prospectDisplayName String?                @map("prospect_display_name") @db.VarChar(200)
  prospectLegalName   String?                @map("prospect_legal_name") @db.VarChar(200)
  prospectEmail       String?                @map("prospect_email") @db.VarChar(320)
  prospectPhone       String?                @map("prospect_phone") @db.VarChar(40)
  prospectCountryCode String?                @map("prospect_country_code") @db.Char(2)
  notes               String?                @db.VarChar(4000)
  createdById         String                 @map("created_by_id") @db.Uuid
  updatedById         String                 @map("updated_by_id") @db.Uuid
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization                 @relation(fields: [organizationId], references: [id])
  customer         Customer?                    @relation(fields: [customerId], references: [id])
  contact          Contact?                     @relation(fields: [contactId], references: [id])
  reseller         Reseller?                    @relation(fields: [resellerId], references: [id])
  lead             Lead?                        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  tender           Tender?                      @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  owner            User                         @relation("OpportunityOwner", fields: [ownerUserId], references: [id])
  currency         Currency                     @relation(fields: [currencyCode], references: [code])
  createdBy        User                         @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  updatedBy        User                         @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id])
  productInterests OpportunityProductInterest[]
  quotes           Quote[]
  salesOrders      SalesOrder[]
  invoices         Invoice[]

  @@index([organizationId, createdAt, id])
  @@index([organizationId, stage, expectedCloseDate])
  @@index([organizationId, ownerUserId, stage])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, resellerId, createdAt])
  @@index([organizationId, leadSource, createdAt])
  @@index([organizationId, tenderId, createdAt])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, deletedAt, createdAt, id], map: "opp_org_del_created_id_idx")
  @@index([organizationId, deletedAt, stage, createdAt, id], map: "opp_org_del_stage_created_id_idx")
  @@index([organizationId, deletedAt, ownerUserId, createdAt, id], map: "opp_org_del_owner_created_id_idx")
  @@index([organizationId, deletedAt, customerId, createdAt, id], map: "opp_org_del_customer_created_id_idx")
  @@index([organizationId, deletedAt, title, id], map: "opp_org_del_title_id_idx")
  @@index([organizationId, deletedAt, opportunityNumber, id], map: "opp_org_del_number_id_idx")
  @@index([organizationId, deletedAt, nextActionDueAt, id], map: "opp_org_del_next_due_id_idx")
  @@index([organizationId, deletedAt, expectedCloseDate, id], map: "opp_org_del_close_id_idx")
  @@index([organizationId, deletedAt, wonAt], map: "opp_org_del_won_idx")
  @@index([organizationId, deletedAt, lostAt], map: "opp_org_del_lost_idx")
  @@index([organizationId, deletedAt, lostReason], map: "opp_org_del_lost_reason_idx")
  @@map("opportunities")
}

/// Product interest on an opportunity — not a quote line.
model OpportunityProductInterest {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  opportunityId       String   @map("opportunity_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  quantity            Decimal  @default(1) @db.Decimal(19, 4)
  estimatedUnitAmount Decimal? @map("estimated_unit_amount") @db.Decimal(19, 4)
  productCode         String   @map("product_code") @db.VarChar(64)
  productName         String   @map("product_name") @db.VarChar(200)
  notes               String?  @db.VarChar(1000)
  sortOrder           Int      @default(0) @map("sort_order")
  createdById         String   @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  createdBy    User         @relation("OpportunityInterestCreatedBy", fields: [createdById], references: [id])

  @@unique([opportunityId, productId])
  @@index([organizationId, opportunityId, sortOrder])
  @@index([organizationId, opportunityId, sortOrder, createdAt, id], map: "opp_interest_org_opp_sort_created_id_idx")
  @@map("opportunity_product_interests")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  FULFILLED
  CLOSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Quote {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  quoteNumber        String      @map("quote_number") @db.VarChar(32)
  customerId         String      @map("customer_id") @db.Uuid
  contactId          String?     @map("contact_id") @db.Uuid
  opportunityId      String?     @map("opportunity_id") @db.Uuid
  ownerUserId        String      @map("owner_user_id") @db.Uuid
  status             QuoteStatus @default(DRAFT)
  issueDate          DateTime    @map("issue_date") @db.Date
  validUntil         DateTime?   @map("valid_until") @db.Date
  customerReference  String?     @map("customer_reference") @db.VarChar(120)
  currencyCode       String      @map("currency_code") @db.Char(3)
  exchangeRateToBase Decimal?    @map("exchange_rate_to_base") @db.Decimal(19, 8)
  baseCurrencyCode   String?     @map("base_currency_code") @db.Char(3)
  paymentTermId      String?     @map("payment_term_id") @db.Uuid
  subtotal           Decimal     @default(0) @db.Decimal(19, 4)
  discountTotal      Decimal     @default(0) @map("discount_total") @db.Decimal(19, 4)
  taxTotal           Decimal     @default(0) @map("tax_total") @db.Decimal(19, 4)
  total              Decimal     @default(0) @db.Decimal(19, 4)
  totalBase          Decimal?    @map("total_base") @db.Decimal(19, 4)
  notes              String?     @db.VarChar(4000)
  terms              String?     @db.VarChar(4000)
  sentAt             DateTime?   @map("sent_at") @db.Timestamptz(6)
  acceptedAt         DateTime?   @map("accepted_at") @db.Timestamptz(6)
  rejectedAt         DateTime?   @map("rejected_at") @db.Timestamptz(6)
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdById        String      @map("created_by_id") @db.Uuid
  updatedById        String      @map("updated_by_id") @db.Uuid
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])
  owner        User         @relation("QuoteOwner", fields: [ownerUserId], references: [id])
  currency     Currency     @relation(fields: [currencyCode], references: [code])
  paymentTerm  PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  createdBy    User         @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("QuoteUpdatedBy", fields: [updatedById], references: [id])
  lines        QuoteLine[]
  salesOrders  SalesOrder[] @relation("QuoteSalesOrders")

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, issueDate])
  @@map("quotes")
}

model QuoteLine {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  quoteId         String   @map("quote_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  productCode     String?  @map("product_code") @db.VarChar(64)
  productName     String   @map("product_name") @db.VarChar(200)
  description     String?  @db.VarChar(1000)
  unitOfMeasure   String?  @map("unit_of_measure") @db.VarChar(32)
  quantity        Decimal  @default(1) @db.Decimal(19, 4)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(19, 4)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(7, 4)
  taxCodeId       String?  @map("tax_code_id") @db.Uuid
  taxCode         String?  @map("tax_code") @db.VarChar(32)
  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(7, 4)
  lineSubtotal    Decimal  @map("line_subtotal") @db.Decimal(19, 4)
  lineDiscount    Decimal  @map("line_discount") @db.Decimal(19, 4)
  lineTax         Decimal  @map("line_tax") @db.Decimal(19, 4)
  lineTotal       Decimal  @map("line_total") @db.Decimal(19, 4)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxCodeRef   TaxCode?     @relation(fields: [taxCodeId], references: [id], onDelete: SetNull)

  @@index([organizationId, quoteId, sortOrder])
  @@map("quote_lines")
}

model SalesOrder {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  salesOrderNumber     String           @map("sales_order_number") @db.VarChar(32)
  sourceQuoteId        String?          @map("source_quote_id") @db.Uuid
  customerId           String           @map("customer_id") @db.Uuid
  contactId            String?          @map("contact_id") @db.Uuid
  opportunityId        String?          @map("opportunity_id") @db.Uuid
  ownerUserId          String           @map("owner_user_id") @db.Uuid
  status               SalesOrderStatus @default(DRAFT)
  orderDate            DateTime         @map("order_date") @db.Date
  expectedDeliveryDate DateTime?        @map("expected_delivery_date") @db.Date
  customerReference    String?          @map("customer_reference") @db.VarChar(120)
  currencyCode         String           @map("currency_code") @db.Char(3)
  exchangeRateToBase   Decimal?         @map("exchange_rate_to_base") @db.Decimal(19, 8)
  baseCurrencyCode     String?          @map("base_currency_code") @db.Char(3)
  paymentTermId        String?          @map("payment_term_id") @db.Uuid
  subtotal             Decimal          @default(0) @db.Decimal(19, 4)
  discountTotal        Decimal          @default(0) @map("discount_total") @db.Decimal(19, 4)
  taxTotal             Decimal          @default(0) @map("tax_total") @db.Decimal(19, 4)
  total                Decimal          @default(0) @db.Decimal(19, 4)
  totalBase            Decimal?         @map("total_base") @db.Decimal(19, 4)
  notes                String?          @db.VarChar(4000)
  terms                String?          @db.VarChar(4000)
  confirmedAt          DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  fulfilledAt          DateTime?        @map("fulfilled_at") @db.Timestamptz(6)
  cancelledAt          DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  closedAt             DateTime?        @map("closed_at") @db.Timestamptz(6)
  createdById          String           @map("created_by_id") @db.Uuid
  updatedById          String           @map("updated_by_id") @db.Uuid
  deletedAt            DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  sourceQuote  Quote?           @relation("QuoteSalesOrders", fields: [sourceQuoteId], references: [id])
  customer     Customer         @relation(fields: [customerId], references: [id])
  contact      Contact?         @relation(fields: [contactId], references: [id])
  opportunity  Opportunity?     @relation(fields: [opportunityId], references: [id])
  owner        User             @relation("SalesOrderOwner", fields: [ownerUserId], references: [id])
  currency     Currency         @relation(fields: [currencyCode], references: [code])
  paymentTerm  PaymentTerm?     @relation(fields: [paymentTermId], references: [id])
  createdBy    User             @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  updatedBy    User             @relation("SalesOrderUpdatedBy", fields: [updatedById], references: [id])
  lines        SalesOrderLine[]
  invoices     Invoice[]        @relation("OrderInvoices")

  @@unique([organizationId, salesOrderNumber])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
