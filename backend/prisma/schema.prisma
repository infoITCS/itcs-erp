  ownerUserId        String          @map("owner_user_id") @db.Uuid
  status             VendorBillStatus @default(DRAFT)
  billDate           DateTime        @map("bill_date") @db.Date
  dueDate            DateTime?       @map("due_date") @db.Date
  vendorReference    String?         @map("vendor_reference") @db.VarChar(120)
  currencyCode       String          @map("currency_code") @db.Char(3)
  exchangeRateToBase Decimal?        @map("exchange_rate_to_base") @db.Decimal(19, 8)
  baseCurrencyCode   String?         @map("base_currency_code") @db.Char(3)
  paymentTermId      String?         @map("payment_term_id") @db.Uuid
  expenseAccount     String?         @map("expense_account") @db.VarChar(120)
  liabilityAccount   String?         @map("liability_account") @db.VarChar(120)
  subtotal           Decimal         @default(0) @db.Decimal(19, 4)
  discountTotal      Decimal         @default(0) @map("discount_total") @db.Decimal(19, 4)
  taxTotal           Decimal         @default(0) @map("tax_total") @db.Decimal(19, 4)
  total              Decimal         @default(0) @db.Decimal(19, 4)
  totalBase          Decimal?        @map("total_base") @db.Decimal(19, 4)
  amountPaid         Decimal         @default(0) @map("amount_paid") @db.Decimal(19, 4)
  notes              String?         @db.VarChar(4000)
  approvedAt         DateTime?       @map("approved_at") @db.Timestamptz(6)
  billedAt           DateTime?       @map("billed_at") @db.Timestamptz(6)
  paidAt             DateTime?       @map("paid_at") @db.Timestamptz(6)
  voidedAt           DateTime?       @map("voided_at") @db.Timestamptz(6)
  createdById        String          @map("created_by_id") @db.Uuid
  updatedById        String          @map("updated_by_id") @db.Uuid
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  owner         User         @relation("VendorBillOwner", fields: [ownerUserId], references: [id])
  currency      Currency     @relation(fields: [currencyCode], references: [code])
  paymentTerm   PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  createdBy     User         @relation("VendorBillCreatedBy", fields: [createdById], references: [id])
  updatedBy     User         @relation("VendorBillUpdatedBy", fields: [updatedById], references: [id])
  lines         VendorBillLine[]
  paymentAllocations VendorPaymentAllocation[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, vendorId, createdAt])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, dueDate])
  @@map("vendor_bills")
}

model VendorBillLine {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  billId          String  @map("bill_id") @db.Uuid
  productId       String? @map("product_id") @db.Uuid
  productCode     String? @map("product_code") @db.VarChar(64)
  productName     String  @map("product_name") @db.VarChar(200)
  description     String? @db.VarChar(1000)
  unitOfMeasure   String? @map("unit_of_measure") @db.VarChar(32)
  quantity        Decimal @default(1) @db.Decimal(19, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(19, 4)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(7, 4)
  taxCodeId       String? @map("tax_code_id") @db.Uuid
  taxCode         String? @map("tax_code") @db.VarChar(32)
  taxRate         Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  lineSubtotal    Decimal @map("line_subtotal") @db.Decimal(19, 4)
  lineDiscount    Decimal @map("line_discount") @db.Decimal(19, 4)
  lineTax         Decimal @map("line_tax") @db.Decimal(19, 4)
  lineTotal       Decimal @map("line_total") @db.Decimal(19, 4)
  sortOrder       Int     @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  bill         VendorBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxCodeRef   TaxCode?     @relation(fields: [taxCodeId], references: [id], onDelete: SetNull)

  @@index([organizationId, billId, sortOrder])
  @@map("vendor_bill_lines")
}

model VendorPayment {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  paymentNumber  String              @map("payment_number") @db.VarChar(32)
  vendorId       String              @map("vendor_id") @db.Uuid
  paidDate       DateTime            @map("paid_date") @db.Date
  method         VendorPaymentMethod @map("method")
  amount         Decimal             @db.Decimal(19, 4)
  currencyCode   String              @map("currency_code") @db.Char(3)
  reference      String?             @db.VarChar(120)
  notes          String?             @db.VarChar(4000)
  status         VendorPaymentStatus @default(DRAFT)
  bankAccount    String?             @map("bank_account") @db.VarChar(120)
  createdById    String              @map("created_by_id") @db.Uuid
  updatedById    String              @map("updated_by_id") @db.Uuid
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  currency     Currency     @relation(fields: [currencyCode], references: [code])
  createdBy    User         @relation("VendorPaymentCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("VendorPaymentUpdatedBy", fields: [updatedById], references: [id])
  allocations  VendorPaymentAllocation[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, vendorId, paidDate])
  @@map("vendor_payments")
}

model VendorPaymentAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  billId         String   @map("bill_id") @db.Uuid
  amount         Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  payment      VendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill         VendorBill   @relation(fields: [billId], references: [id])

  @@index([organizationId, paymentId])
  @@index([organizationId, billId])
  @@map("vendor_payment_allocations")
}

model InventoryMovement {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  movementType   InventoryMovementType @map("movement_type")
  quantity       Decimal              @db.Decimal(19, 4)
  unitCost       Decimal              @map("unit_cost") @db.Decimal(19, 4)
  location       String               @db.VarChar(120)
  referenceType  String               @map("reference_type") @db.VarChar(64)
  referenceId    String               @map("reference_id") @db.Uuid
  balanceAfter   Decimal              @map("balance_after") @db.Decimal(19, 4)
  createdById    String               @map("created_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  createdBy    User         @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, createdAt, id])
  @@index([organizationId, productId, createdAt])
  @@index([organizationId, movementType, createdAt])
  @@index([organizationId, location, createdAt])
  @@map("inventory_movements")
}

model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  location    String   @db.VarChar(120)
  quantity    Decimal  @default(0) @db.Decimal(19, 4)
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(19, 4)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([organizationId, productId, location])
  @@index([organizationId, location])
  @@map("inventory_balances")
}
