  taxCodeId       String?       @map("tax_code_id") @db.Uuid
  trackInventory        Boolean       @default(false) @map("track_inventory")
  valuationMethod       String        @default("WEIGHTED_AVERAGE") @map("valuation_method") @db.VarChar(32)
  weightedAveragePrice  Decimal       @default(0) @map("weighted_average_price") @db.Decimal(19, 4)
  allowNegativeStock    Boolean       @default(false) @map("allow_negative_stock")
  minimumStockQuantity  Decimal       @default(0) @map("minimum_stock_quantity") @db.Decimal(19, 4)
  receivingLocation     String        @default("MAIN LOCATION") @map("receiving_location") @db.VarChar(120)
