// Phase 1 plus customers/contacts, products/services, and resellers.
// Opportunities, sales, purchasing, inventory, accounting, and tender tables are not in this schema.
//
// Finalized financial documents (invoices, payments, bills, journals) will be
// append-only after posting. A correction is a new reversing document.
// Amount columns on those future tables will be Decimal @db.Decimal(19, 4).
// Exchange rates below already use Decimal. Do not store money as float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("account_status")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE

  @@map("organization_status")
}

enum DocumentType {
  QUOTE
  SALES_ORDER
  INVOICE
  PURCHASE_ORDER
  BILL
  TENDER
  PAYMENT
  RENEWAL
  CUSTOMER
  PRODUCT
  RESELLER

  @@map("document_type")
}

enum CustomerType {
  COMPANY
  INDIVIDUAL

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

enum AddressPurpose {
  BILLING
  SHIPPING

  @@map("address_purpose")
}

enum ContactStatus {
  ACTIVE
  INACTIVE

  @@map("contact_status")
}

enum ProductType {
  PHYSICAL_PRODUCT
  SERVICE

  @@map("product_type")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum ProductPriceType {
  SALES
  PURCHASE

  @@map("product_price_type")
}

enum ResellerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("reseller_status")
}

/// Company boundary. Later operational tables will reference this id.
/// One row is seeded now. This is not SaaS tenant isolation.
model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique @db.VarChar(32)
  name             String             @db.VarChar(200)
  status           OrganizationStatus @default(ACTIVE)
  baseCurrencyCode String             @map("base_currency_code") @db.Char(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  baseCurrency      Currency           @relation(fields: [baseCurrencyCode], references: [code])
  members           OrganizationMember[]
  roles             Role[]
  auditLogs         AuditLog[]
  exchangeRates     ExchangeRate[]
  documentSequences DocumentSequence[]
  customers         Customer[]
  resellers         Reseller[]
  resellerAddresses ResellerAddress[]
  resellerContacts  ResellerContact[]
  products          Product[]
  productCategories ProductCategory[]
  unitsOfMeasure    UnitOfMeasure[]
  taxCodes          TaxCode[]
  productPrices     ProductPrice[]

  @@index([status])
  @@map("organizations")
}

/// A person. Company access is OrganizationMember, so a second company
/// does not require a new users table.
model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique @db.VarChar(320)
  passwordHash      String        @map("password_hash") @db.VarChar(255)
  firstName         String        @map("first_name") @db.VarChar(100)
  lastName          String        @map("last_name") @db.VarChar(100)
  status            AccountStatus @default(ACTIVE)
  failedLoginCount  Int           @default(0) @map("failed_login_count")
  lockedAt          DateTime?     @map("locked_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?     @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    OrganizationMember[]
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]
  customersCreated Customer[]        @relation("CustomerCreatedBy")
  customersUpdated Customer[]        @relation("CustomerUpdatedBy")
  addressesCreated CustomerAddress[] @relation("AddressCreatedBy")
  addressesUpdated CustomerAddress[] @relation("AddressUpdatedBy")
  contactsCreated  Contact[]         @relation("ContactCreatedBy")
  contactsUpdated  Contact[]         @relation("ContactUpdatedBy")
  resellersCreated Reseller[]        @relation("ResellerCreatedBy")
  resellersUpdated Reseller[]        @relation("ResellerUpdatedBy")
  resellerAddressesCreated ResellerAddress[] @relation("ResellerAddressCreatedBy")
  resellerAddressesUpdated ResellerAddress[] @relation("ResellerAddressUpdatedBy")
  resellerContactsCreated  ResellerContact[] @relation("ResellerContactCreatedBy")
  resellerContactsUpdated  ResellerContact[] @relation("ResellerContactUpdatedBy")
  productsCreated  Product[]         @relation("ProductCreatedBy")
  productsUpdated  Product[]         @relation("ProductUpdatedBy")
  categoriesCreated ProductCategory[] @relation("CategoryCreatedBy")
  categoriesUpdated ProductCategory[] @relation("CategoryUpdatedBy")
  pricesCreated    ProductPrice[]    @relation("PriceCreatedBy")
  pricesUpdated    ProductPrice[]    @relation("PriceUpdatedBy")

  @@index([status])
  @@map("users")
}

model OrganizationMember {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Roles belong to one organization. Permission codes are global.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(64)
  name           String   @db.VarChar(120)
  description    String?  @db.VarChar(500)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(64)
  action      String   @db.VarChar(32)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Server-side session. The access token stays stateless.
/// Only the SHA-256 hash of the refresh token is stored.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(64)
  module         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([module, entityType, entityId])
  @@index([createdAt, id])
  @@map("audit_logs")
}

model Currency {
  code          String   @id @db.Char(3)
  name          String   @db.VarChar(80)
  symbol        String   @db.VarChar(8)
  decimalPlaces Int      @default(2) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations Organization[]
  customers     Customer[]
  resellers     Reseller[]
  productPrices ProductPrice[]
  baseRates     ExchangeRate[] @relation("ExchangeRateBase")
  quoteRates    ExchangeRate[] @relation("ExchangeRateQuote")

  @@index([isActive])
  @@map("currencies")
}

/// Rate is quote-currency units per 1 base-currency unit.
/// Example: base USD, quote PKR, rate 278.50000000 means 1 USD = 278.50 PKR.
model ExchangeRate {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  baseCurrencyCode  String   @map("base_currency_code") @db.Char(3)
  quoteCurrencyCode String   @map("quote_currency_code") @db.Char(3)
  rate              Decimal  @db.Decimal(19, 8)
  effectiveDate     DateTime @map("effective_date") @db.Date
  source            String   @db.VarChar(80)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id])
  baseCurrency  Currency     @relation("ExchangeRateBase", fields: [baseCurrencyCode], references: [code])
  quoteCurrency Currency     @relation("ExchangeRateQuote", fields: [quoteCurrencyCode], references: [code])

  @@unique([organizationId, baseCurrencyCode, quoteCurrencyCode, effectiveDate])
  @@index([organizationId, baseCurrencyCode, quoteCurrencyCode, effectiveDate])
  @@map("exchange_rates")
}

/// Shared counter for future quotes, orders, invoices, bills, and the other
/// document types. Allocating a number locks this row inside a transaction.
model DocumentSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  documentType   DocumentType @map("document_type")
  prefix         String       @db.VarChar(16)
  nextNumber     Int          @default(1) @map("next_number")
  padding        Int          @default(5)
  year           Int
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, documentType, year])
  @@map("document_sequences")
}

/// Commercial party. Prospect status belongs to a future Opportunities module.
/// Soft-deleted rows stay so later documents can still reference the id.
model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  resellerId     String?        @map("reseller_id") @db.Uuid
  customerNumber String         @map("customer_number") @db.VarChar(32)
  customerType   CustomerType   @map("customer_type")
  legalName      String         @map("legal_name") @db.VarChar(200)
  displayName    String         @map("display_name") @db.VarChar(200)
  email          String?        @db.VarChar(320)
  phone          String?        @db.VarChar(40)
  website        String?        @db.VarChar(200)
  countryCode    String         @map("country_code") @db.Char(2)
  currencyCode   String         @map("currency_code") @db.Char(3)
  taxNumber      String?        @map("tax_number") @db.VarChar(64)
  status         CustomerStatus @default(ACTIVE)
  notes          String?        @db.VarChar(4000)
  createdById    String         @map("created_by_id") @db.Uuid
  updatedById    String         @map("updated_by_id") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  reseller     Reseller?         @relation(fields: [resellerId], references: [id])
  currency     Currency          @relation(fields: [currencyCode], references: [code])
  createdBy    User              @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy    User              @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  addresses    CustomerAddress[]
  contacts     Contact[]

  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerType, createdAt])
  @@index([organizationId, countryCode, createdAt])
  @@index([organizationId, currencyCode])
  @@index([organizationId, resellerId, createdAt])
  @@map("customers")
}

model CustomerAddress {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  purpose        AddressPurpose
  isPrimary      Boolean        @default(false) @map("is_primary")
  label          String?        @db.VarChar(80)
  line1          String         @db.VarChar(200)
  line2          String?        @db.VarChar(200)
  city           String         @db.VarChar(120)
  region         String?        @db.VarChar(120)
  postalCode     String?        @map("postal_code") @db.VarChar(20)
  countryCode    String         @map("country_code") @db.Char(2)
  createdById    String         @map("created_by_id") @db.Uuid
  updatedById    String         @map("updated_by_id") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation("AddressCreatedBy", fields: [createdById], references: [id])
  updatedBy User     @relation("AddressUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId, customerId, purpose])
  @@map("customer_addresses")
}

model Contact {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  firstName      String        @map("first_name") @db.VarChar(100)
  lastName       String        @map("last_name") @db.VarChar(100)
  displayName    String        @map("display_name") @db.VarChar(200)
  jobTitle       String?       @map("job_title") @db.VarChar(120)
  department     String?       @db.VarChar(120)
  email          String?       @db.VarChar(320)
  phone          String?       @db.VarChar(40)
  mobile         String?       @db.VarChar(40)
  isPrimary      Boolean       @default(false) @map("is_primary")
  status         ContactStatus @default(ACTIVE)
  notes          String?       @db.VarChar(4000)
  createdById    String        @map("created_by_id") @db.Uuid
  updatedById    String        @map("updated_by_id") @db.Uuid
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation("ContactCreatedBy", fields: [createdById], references: [id])
  updatedBy User     @relation("ContactUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId, customerId, createdAt, id])
  @@index([organizationId, email])
  @@map("contacts")
}

model Reseller {
  id                       String         @id @default(uuid()) @db.Uuid
  organizationId           String         @map("organization_id") @db.Uuid
  resellerNumber           String         @map("reseller_number") @db.VarChar(32)
  legalName                String         @map("legal_name") @db.VarChar(200)
  displayName              String         @map("display_name") @db.VarChar(200)
  email                    String?        @db.VarChar(320)
  phone                    String?        @db.VarChar(40)
  website                  String?        @db.VarChar(200)
  countryCode              String         @map("country_code") @db.Char(2)
  currencyCode             String         @map("currency_code") @db.Char(3)
  taxNumber                String?        @map("tax_number") @db.VarChar(64)
  status                   ResellerStatus @default(ACTIVE)
  priceListCode            String         @default("STANDARD") @map("price_list_code") @db.VarChar(32)
  defaultDiscountPercent   Decimal?       @map("default_discount_percent") @db.Decimal(7, 4)
  defaultCommissionPercent Decimal?       @map("default_commission_percent") @db.Decimal(7, 4)
  notes                    String?        @db.VarChar(4000)
  createdById              String         @map("created_by_id") @db.Uuid
  updatedById              String         @map("updated_by_id") @db.Uuid
  deletedAt                DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  currency     Currency          @relation(fields: [currencyCode], references: [code])
  createdBy    User              @relation("ResellerCreatedBy", fields: [createdById], references: [id])
  updatedBy    User              @relation("ResellerUpdatedBy", fields: [updatedById], references: [id])
  addresses    ResellerAddress[]
  contacts     ResellerContact[]
  customers    Customer[]

  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, countryCode, createdAt])
  @@map("resellers")
}

model ResellerAddress {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  resellerId     String         @map("reseller_id") @db.Uuid
  purpose        AddressPurpose
  isPrimary      Boolean        @default(false) @map("is_primary")
  label          String?        @db.VarChar(80)
  line1          String         @db.VarChar(200)
  line2          String?        @db.VarChar(200)
  city           String         @db.VarChar(120)
  region         String?        @db.VarChar(120)
  postalCode     String?        @map("postal_code") @db.VarChar(20)
  countryCode    String         @map("country_code") @db.Char(2)
  createdById    String         @map("created_by_id") @db.Uuid
  updatedById    String         @map("updated_by_id") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  reseller     Reseller     @relation(fields: [resellerId], references: [id])
  createdBy    User         @relation("ResellerAddressCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("ResellerAddressUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId, resellerId, purpose])
  @@map("reseller_addresses")
}

model ResellerContact {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  resellerId     String        @map("reseller_id") @db.Uuid
  firstName      String        @map("first_name") @db.VarChar(100)
  lastName       String        @map("last_name") @db.VarChar(100)
  displayName    String        @map("display_name") @db.VarChar(200)
  jobTitle       String?       @map("job_title") @db.VarChar(120)
  department     String?       @db.VarChar(120)
  email          String?       @db.VarChar(320)
  phone          String?       @db.VarChar(40)
  mobile         String?       @db.VarChar(40)
  isPrimary      Boolean       @default(false) @map("is_primary")
  status         ContactStatus @default(ACTIVE)
  notes          String?       @db.VarChar(4000)
  createdById    String        @map("created_by_id") @db.Uuid
  updatedById    String        @map("updated_by_id") @db.Uuid
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  reseller     Reseller     @relation(fields: [resellerId], references: [id])
  createdBy    User         @relation("ResellerContactCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("ResellerContactUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId, resellerId, createdAt, id])
  @@index([organizationId, email])
  @@map("reseller_contacts")
}

model UnitOfMeasure {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(80)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@unique([organizationId, code])
  @@map("units_of_measure")
}

model ProductCategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  code           String    @db.VarChar(32)
  name           String    @db.VarChar(120)
  description    String?   @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  createdById    String    @map("created_by_id") @db.Uuid
  updatedById    String    @map("updated_by_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  parent       ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("CategoryTree")
  products     Product[]
  createdBy    User              @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy    User              @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId, parentId])
  @@index([organizationId, createdAt, id])
  @@map("product_categories")
}

/// Stub for later quote/invoice lines. Not a full tax engine.
model TaxCode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(120)
  rate           Decimal  @db.Decimal(7, 4)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@unique([organizationId, code])
  @@map("tax_codes")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  code            String        @db.VarChar(64)
  name            String        @db.VarChar(200)
  description     String?       @db.VarChar(4000)
  productType     ProductType   @map("product_type")
  status          ProductStatus @default(ACTIVE)
  categoryId      String?       @map("category_id") @db.Uuid
  unitOfMeasureId String        @map("unit_of_measure_id") @db.Uuid
  taxCodeId       String?       @map("tax_code_id") @db.Uuid
  trackInventory  Boolean       @default(false) @map("track_inventory")
  notes           String?       @db.VarChar(4000)
  createdById     String        @map("created_by_id") @db.Uuid
  updatedById     String        @map("updated_by_id") @db.Uuid
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id])
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  unitOfMeasure UnitOfMeasure    @relation(fields: [unitOfMeasureId], references: [id])
  taxCode       TaxCode?         @relation(fields: [taxCodeId], references: [id])
  createdBy     User             @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy     User             @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  prices        ProductPrice[]

  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, productType, createdAt])
  @@index([organizationId, categoryId, createdAt])
  @@index([organizationId, trackInventory])
  @@map("products")
}

model ProductPrice {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  productId      String           @map("product_id") @db.Uuid
  priceType      ProductPriceType @map("price_type")
  priceListCode  String           @default("STANDARD") @map("price_list_code") @db.VarChar(32)
  currencyCode   String           @map("currency_code") @db.Char(3)
  amount         Decimal          @db.Decimal(19, 4)
  effectiveDate  DateTime         @map("effective_date") @db.Date
  expiryDate     DateTime?        @map("expiry_date") @db.Date
  isActive       Boolean          @default(true) @map("is_active")
  createdById    String           @map("created_by_id") @db.Uuid
  updatedById    String           @map("updated_by_id") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  currency     Currency     @relation(fields: [currencyCode], references: [code])
  createdBy    User         @relation("PriceCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("PriceUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId, productId, priceType, effectiveDate])
  @@index([organizationId, priceListCode, currencyCode])
  @@map("product_prices")
}
