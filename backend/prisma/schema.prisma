/// CRM pipeline record. Prospects live here until converted to a Customer.
model Opportunity {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  opportunityNumber    String                 @map("opportunity_number") @db.VarChar(32)
  title                String                 @db.VarChar(200)
  description          String?                @db.VarChar(4000)
  stage                OpportunityStage       @default(NEW)
  customerId           String?                @map("customer_id") @db.Uuid
  contactId            String?                @map("contact_id") @db.Uuid
  resellerId           String?                @map("reseller_id") @db.Uuid
  ownerUserId          String                 @map("owner_user_id") @db.Uuid
  leadSource           CustomerLeadSource?    @map("lead_source")
  estimatedValue       Decimal                @default(0) @map("estimated_value") @db.Decimal(19, 4)
  currencyCode         String                 @map("currency_code") @db.Char(3)
  exchangeRateToBase   Decimal?               @map("exchange_rate_to_base") @db.Decimal(19, 8)
  estimatedValueBase   Decimal?               @map("estimated_value_base") @db.Decimal(19, 4)
  baseCurrencyCode     String?                @map("base_currency_code") @db.Char(3)
  probabilityPercent   Int                    @default(10) @map("probability_percent")
  expectedCloseDate    DateTime?              @map("expected_close_date") @db.Date
  nextAction           String?                @map("next_action") @db.VarChar(500)
  nextActionDueAt      DateTime?              @map("next_action_due_at") @db.Timestamptz(6)
  lostReason           OpportunityLostReason? @map("lost_reason")
  lostReasonDetail     String?                @map("lost_reason_detail") @db.VarChar(500)
  competitorName       String?                @map("competitor_name") @db.VarChar(200)
  wonAt                DateTime?              @map("won_at") @db.Timestamptz(6)
  lostAt               DateTime?              @map("lost_at") @db.Timestamptz(6)
  closedAt             DateTime?              @map("closed_at") @db.Timestamptz(6)
  reopenedAt           DateTime?              @map("reopened_at") @db.Timestamptz(6)
  prospectDisplayName  String?                @map("prospect_display_name") @db.VarChar(200)
  prospectLegalName    String?                @map("prospect_legal_name") @db.VarChar(200)
  prospectEmail        String?                @map("prospect_email") @db.VarChar(320)
  prospectPhone        String?                @map("prospect_phone") @db.VarChar(40)
  prospectCountryCode  String?                @map("prospect_country_code") @db.Char(2)
  notes                String?                @db.VarChar(4000)
  createdById          String                 @map("created_by_id") @db.Uuid
  updatedById          String                 @map("updated_by_id") @db.Uuid
  deletedAt            DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization                 @relation(fields: [organizationId], references: [id])
  customer     Customer?                    @relation(fields: [customerId], references: [id])
  contact      Contact?                     @relation(fields: [contactId], references: [id])
  reseller     Reseller?                    @relation(fields: [resellerId], references: [id])
  owner        User                         @relation("OpportunityOwner", fields: [ownerUserId], references: [id])
  currency     Currency                     @relation(fields: [currencyCode], references: [code])
  createdBy    User                         @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  updatedBy    User                         @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id])
  productInterests OpportunityProductInterest[]

  @@index([organizationId, createdAt, id])
  @@index([organizationId, stage, expectedCloseDate])
  @@index([organizationId, ownerUserId, stage])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, resellerId, createdAt])
  @@index([organizationId, leadSource, createdAt])
  @@index([organizationId, expectedCloseDate])
  @@map("opportunities")
}

/// Product interest on an opportunity — not a quote line.
