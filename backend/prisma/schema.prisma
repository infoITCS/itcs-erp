// Phase 1: identity, audit, currencies, organization readiness, document numbers.
// Sales, purchasing, inventory, accounting, and tender tables are not in this schema.
//
// Finalized financial documents (invoices, payments, bills, journals) will be
// append-only after posting. A correction is a new reversing document.
// Amount columns on those future tables will be Decimal @db.Decimal(19, 4).
// Exchange rates below already use Decimal. Do not store money as float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("account_status")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE

  @@map("organization_status")
}

enum DocumentType {
  QUOTE
  SALES_ORDER
  INVOICE
  PURCHASE_ORDER
  BILL
  TENDER
  PAYMENT
  RENEWAL

  @@map("document_type")
}

/// Company boundary. Later operational tables will reference this id.
/// One row is seeded now. This is not SaaS tenant isolation.
model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique @db.VarChar(32)
  name             String             @db.VarChar(200)
  status           OrganizationStatus @default(ACTIVE)
  baseCurrencyCode String             @map("base_currency_code") @db.Char(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  baseCurrency      Currency           @relation(fields: [baseCurrencyCode], references: [code])
  members           OrganizationMember[]
  roles             Role[]
  auditLogs         AuditLog[]
  exchangeRates     ExchangeRate[]
  documentSequences DocumentSequence[]

  @@index([status])
  @@map("organizations")
}

/// A person. Company access is OrganizationMember, so a second company
/// does not require a new users table.
model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique @db.VarChar(320)
  passwordHash      String        @map("password_hash") @db.VarChar(255)
  firstName         String        @map("first_name") @db.VarChar(100)
  lastName          String        @map("last_name") @db.VarChar(100)
  status            AccountStatus @default(ACTIVE)
  failedLoginCount  Int           @default(0) @map("failed_login_count")
  lockedAt          DateTime?     @map("locked_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?     @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    OrganizationMember[]
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]

  @@index([status])
  @@map("users")
}

model OrganizationMember {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Roles belong to one organization. Permission codes are global.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(64)
  name           String   @db.VarChar(120)
  description    String?  @db.VarChar(500)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(64)
  action      String   @db.VarChar(32)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Server-side session. The access token stays stateless.
/// Only the SHA-256 hash of the refresh token is stored.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(64)
  module         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([module, entityType, entityId])
  @@index([createdAt, id])
  @@map("audit_logs")
}

model Currency {
  code          String   @id @db.Char(3)
  name          String   @db.VarChar(80)
  symbol        String   @db.VarChar(8)
  decimalPlaces Int      @default(2) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations Organization[]
  baseRates     ExchangeRate[] @relation("ExchangeRateBase")
  quoteRates    ExchangeRate[] @relation("ExchangeRateQuote")

  @@index([isActive])
  @@map("currencies")
}

/// Rate is quote-currency units per 1 base-currency unit.
/// Example: base USD, quote PKR, rate 278.50000000 means 1 USD = 278.50 PKR.
model ExchangeRate {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  baseCurrencyCode  String   @map("base_currency_code") @db.Char(3)
  quoteCurrencyCode String   @map("quote_currency_code") @db.Char(3)
  rate              Decimal  @db.Decimal(19, 8)
  effectiveDate     DateTime @map("effective_date") @db.Date
  source            String   @db.VarChar(80)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id])
  baseCurrency  Currency     @relation("ExchangeRateBase", fields: [baseCurrencyCode], references: [code])
  quoteCurrency Currency     @relation("ExchangeRateQuote", fields: [quoteCurrencyCode], references: [code])

  @@unique([organizationId, baseCurrencyCode, quoteCurrencyCode, effectiveDate])
  @@index([organizationId, baseCurrencyCode, quoteCurrencyCode, effectiveDate])
  @@map("exchange_rates")
}

/// Shared counter for future quotes, orders, invoices, bills, and the other
/// document types. Allocating a number locks this row inside a transaction.
model DocumentSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  documentType   DocumentType @map("document_type")
  prefix         String       @db.VarChar(16)
  nextNumber     Int          @default(1) @map("next_number")
  padding        Int          @default(5)
  year           Int
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, documentType, year])
  @@map("document_sequences")
}
