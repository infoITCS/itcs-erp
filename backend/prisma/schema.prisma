/// Store object-storage metadata here; file bytes belong in private blob storage.
model CustomerDocument {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  customerId       String               @map("customer_id") @db.Uuid
  documentType     CustomerDocumentType @map("document_type")
  displayName      String               @map("display_name") @db.VarChar(160)
  originalFileName String               @map("original_file_name") @db.VarChar(255)
  storageKey       String               @map("storage_key") @db.VarChar(500)
  mimeType         String               @map("mime_type") @db.VarChar(120)
  sizeBytes        BigInt               @map("size_bytes")
  sha256           String?              @db.Char(64)
  uploadedById     String               @map("uploaded_by_id") @db.Uuid
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)
