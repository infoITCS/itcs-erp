// Phase 1 plus customers/contacts, products/services, resellers, and opportunities.
// Quotes, orders, invoices, purchasing, inventory, accounting, and tender tables are not in this schema.
//
// Finalized financial documents (invoices, payments, bills, journals) will be
// append-only after posting. A correction is a new reversing document.
// Amount columns on those future tables will be Decimal @db.Decimal(19, 4).
// Exchange rates below already use Decimal. Do not store money as float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("account_status")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE

  @@map("organization_status")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("vendor_status")
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  BILLED
  CLOSED
  CANCELLED

  @@map("purchase_order_status")
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED

  @@map("goods_receipt_status")
}

enum VendorBillStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  VOID

  @@map("vendor_bill_status")
}

enum VendorPaymentStatus {
  DRAFT
  PAID
  CANCELLED

  @@map("vendor_payment_status")
}

enum VendorPaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CHEQUE
  MOBILE_WALLET
  ONLINE
  OTHER

  @@map("vendor_payment_method")
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  ADJUSTMENT
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT

  @@map("inventory_movement_type")
}

enum DocumentType {
  QUOTE
  SALES_ORDER
  INVOICE
  PURCHASE_ORDER
  GOODS_RECEIPT
  BILL
  VENDOR_PAYMENT
  TENDER
  PAYMENT
  RENEWAL
  CUSTOMER
  PRODUCT
  RESELLER
  OPPORTUNITY
  LEAD
  PROJECT

  @@map("document_type")
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("project_status")
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("project_priority")
}

enum BillingMode {
  FIXED_PRICE
  TIME_MATERIALS
  RETAINER

  @@map("billing_mode")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  WON

  @@map("lead_status")
}

enum OpportunityStage {
  NEW
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  WON
  LOST

  @@map("opportunity_stage")
}

enum OpportunityLostReason {
  PRICE
  COMPETITOR
  NO_BUDGET
  NO_DECISION
  TIMING
  SCOPE_MISMATCH
  INTERNAL
  OTHER

  @@map("opportunity_lost_reason")
}

enum TenderStatus {
  DRAFT
  OPEN
  SUBMITTED
  WON
  LOST
  CANCELLED

  @@map("tender_status")
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
  B2B
  B2C
  WHOLESALE

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  HOLD

  @@map("customer_status")
}

enum AddressPurpose {
  BILLING
  SHIPPING

  @@map("address_purpose")
}

enum ContactStatus {
  ACTIVE
  INACTIVE

  @@map("contact_status")
}

enum CustomerLeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  SOCIAL_MEDIA
  ADVERTISEMENT
  PARTNER
  TENDER
  OTHER

  @@map("customer_lead_source")
}

enum CustomerTaxIdType {
  NTN
  STRN
  OTHER

  @@map("customer_tax_id_type")
}

enum CustomerEntityType {
  COMPANY
  INDIVIDUAL

  @@map("customer_entity_type")
}

enum CustomerCategory {
  RETAIL
  WHOLESALE
  CORPORATE
  VIP
  PARTNER
  OTHER

  @@map("customer_category")
}

enum CustomerRating {
  HOT
  WARM
  COLD
  MISCELLANEOUS

  @@map("customer_rating")
}

enum CustomerPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("customer_priority")
}

enum CustomerIncorporationStatus {
  REGISTERED
  PENDING
  UNREGISTERED
  NOT_APPLICABLE

  @@map("customer_incorporation_status")
}

enum CustomerIdentityDocumentType {
  CNIC
  PASSPORT

  @@map("customer_identity_document_type")
}

enum CustomerPaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  CHEQUE
  MOBILE_WALLET
  OTHER

  @@map("customer_payment_method")
}

enum CustomerCommunicationChannel {
  EMAIL
  PHONE
  SMS
  WHATSAPP

  @@map("customer_communication_channel")
}

enum ContactMethod {
  EMAIL
  PHONE
  SMS

  @@map("contact_method")
}

enum CustomerContactRole {
  BILLING
  PROCUREMENT
  FINANCE
  OPERATIONS
  SALES
  OTHER

  @@map("customer_contact_role")
}

enum CustomerPricingGroupType {
  PRICING_TIER
  DISCOUNT_GROUP

  @@map("customer_pricing_group_type")
}

enum CustomerNoteType {
  GENERAL
  BILLING
  SUPPORT
  INTERNAL

  @@map("customer_note_type")
}

enum CustomerActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  SITE_VISIT
  OTHER

  @@map("customer_activity_type")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED

  @@map("support_ticket_status")
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("support_ticket_priority")
}

enum CustomerDocumentType {
  NDA
  TAX_CERTIFICATE
  CONTRACT
  PURCHASE_ORDER
  OTHER

  @@map("customer_document_type")
}

enum ProductType {
  PHYSICAL_PRODUCT
  SERVICE

  @@map("product_type")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum ProductPriceType {
  SALES
  PURCHASE

  @@map("product_price_type")
}

enum ResellerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("reseller_status")
}

/// Company boundary. Later operational tables will reference this id.
/// One row is seeded now. This is not SaaS tenant isolation.
model Organization {
  id                    String             @id @default(uuid()) @db.Uuid
  code                  String             @unique @db.VarChar(32)
  name                  String             @db.VarChar(200)
  status                OrganizationStatus @default(ACTIVE)
  baseCurrencyCode      String             @map("base_currency_code") @db.Char(3)
  auditLogRetentionDays Int                @default(365) @map("audit_log_retention_days")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  baseCurrency           Currency                     @relation(fields: [baseCurrencyCode], references: [code])
  members                OrganizationMember[]
  roles                  Role[]
  auditLogs              AuditLog[]
  exchangeRates          ExchangeRate[]
  documentSequences      DocumentSequence[]
  customers              Customer[]
  resellers              Reseller[]
  resellerAddresses      ResellerAddress[]
  resellerContacts       ResellerContact[]
  products               Product[]
  productCategories      ProductCategory[]
  unitsOfMeasure         UnitOfMeasure[]
  taxCodes               TaxCode[]
  productPrices          ProductPrice[]
  paymentTerms           PaymentTerm[]
  customerPricingGroups  CustomerPricingGroup[]
  accountingCategories   AccountingCategory[]
  customerNotes          CustomerNote[]
  customerActivities     CustomerActivity[]
  customerSupportTickets CustomerSupportTicket[]
  customerDocuments      CustomerDocument[]
  opportunities          Opportunity[]
  opportunityInterests   OpportunityProductInterest[]
  tenders                Tender[]
  leads                  Lead[]
  quotes                 Quote[]
  salesOrders            SalesOrder[]
  invoices               Invoice[]
  payments               Payment[]
  quoteLines             QuoteLine[]
  salesOrderLines        SalesOrderLine[]
  invoiceLines           InvoiceLine[]
  vendors                Vendor[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderLines     PurchaseOrderLine[]
  goodsReceipts          GoodsReceipt[]
  goodsReceiptLines      GoodsReceiptLine[]
  vendorBills            VendorBill[]
  vendorBillLines        VendorBillLine[]
  vendorPayments         VendorPayment[]
  vendorPaymentAllocations VendorPaymentAllocation[]
  inventoryMovements     InventoryMovement[]
  inventoryBalances      InventoryBalance[]

  @@index([status])
  @@map("organizations")
}

/// A person. Company access is OrganizationMember, so a second company
/// does not require a new users table.
model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique @db.VarChar(320)
  passwordHash      String        @map("password_hash") @db.VarChar(255)
  firstName         String        @map("first_name") @db.VarChar(100)
  lastName          String        @map("last_name") @db.VarChar(100)
  phone             String?       @db.VarChar(32)
  jobTitle          String?       @map("job_title") @db.VarChar(120)
  department        String?       @db.VarChar(120)
  location          String?       @db.VarChar(160)
  bio               String?       @db.VarChar(500)
  avatarUrl         String?       @map("avatar_url") @db.Text
  status            AccountStatus @default(ACTIVE)
  failedLoginCount  Int           @default(0) @map("failed_login_count")
  lockedAt          DateTime?     @map("locked_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?     @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships                 OrganizationMember[]
  userRoles                   UserRole[]
  refreshTokens               RefreshToken[]
  passwordResets              PasswordResetToken[]
  auditLogs                   AuditLog[]
  customersCreated            Customer[]                   @relation("CustomerCreatedBy")
  customersUpdated            Customer[]                   @relation("CustomerUpdatedBy")
  customersAssigned           Customer[]                   @relation("CustomerSalesRep")
  addressesCreated            CustomerAddress[]            @relation("AddressCreatedBy")
  addressesUpdated            CustomerAddress[]            @relation("AddressUpdatedBy")
  contactsCreated             Contact[]                    @relation("ContactCreatedBy")
  contactsUpdated             Contact[]                    @relation("ContactUpdatedBy")
  resellersCreated            Reseller[]                   @relation("ResellerCreatedBy")
  resellersUpdated            Reseller[]                   @relation("ResellerUpdatedBy")
  resellerAddressesCreated    ResellerAddress[]            @relation("ResellerAddressCreatedBy")
  resellerAddressesUpdated    ResellerAddress[]            @relation("ResellerAddressUpdatedBy")
  resellerContactsCreated     ResellerContact[]            @relation("ResellerContactCreatedBy")
  resellerContactsUpdated     ResellerContact[]            @relation("ResellerContactUpdatedBy")
  productsCreated             Product[]                    @relation("ProductCreatedBy")
  productsUpdated             Product[]                    @relation("ProductUpdatedBy")
  categoriesCreated           ProductCategory[]            @relation("CategoryCreatedBy")
  categoriesUpdated           ProductCategory[]            @relation("CategoryUpdatedBy")
  pricesCreated               ProductPrice[]               @relation("PriceCreatedBy")
  pricesUpdated               ProductPrice[]               @relation("PriceUpdatedBy")
  customerNotesCreated        CustomerNote[]               @relation("CustomerNoteCreatedBy")
  customerActivitiesCreated   CustomerActivity[]           @relation("CustomerActivityCreatedBy")
  customerTicketsCreated      CustomerSupportTicket[]      @relation("CustomerTicketCreatedBy")
  customerTicketsUpdated      CustomerSupportTicket[]      @relation("CustomerTicketUpdatedBy")
  customerDocumentsUploaded   CustomerDocument[]           @relation("CustomerDocumentUploadedBy")
  opportunitiesOwned          Opportunity[]                @relation("OpportunityOwner")
  opportunitiesCreated        Opportunity[]                @relation("OpportunityCreatedBy")
  opportunitiesUpdated        Opportunity[]                @relation("OpportunityUpdatedBy")
  opportunityInterestsCreated OpportunityProductInterest[] @relation("OpportunityInterestCreatedBy")
  tendersOwned                Tender[]                     @relation("TenderOwner")
  tendersCreated              Tender[]                     @relation("TenderCreatedBy")
  tendersUpdated              Tender[]                     @relation("TenderUpdatedBy")
  leadsOwned                  Lead[]                       @relation("LeadOwner")
  leadsCreated                Lead[]                       @relation("LeadCreatedBy")
  leadsUpdated                Lead[]                       @relation("LeadUpdatedBy")
  quotesOwned                 Quote[]                      @relation("QuoteOwner")
  quotesCreated               Quote[]                      @relation("QuoteCreatedBy")
  quotesUpdated               Quote[]                      @relation("QuoteUpdatedBy")
  salesOrdersOwned            SalesOrder[]                 @relation("SalesOrderOwner")
  salesOrdersCreated          SalesOrder[]                 @relation("SalesOrderCreatedBy")
  salesOrdersUpdated          SalesOrder[]                 @relation("SalesOrderUpdatedBy")
  invoicesOwned               Invoice[]                    @relation("InvoiceOwner")
  invoicesCreated             Invoice[]                    @relation("InvoiceCreatedBy")
  invoicesUpdated             Invoice[]                    @relation("InvoiceUpdatedBy")
  paymentsCreated             Payment[]                    @relation("PaymentCreatedBy")
  paymentsUpdated             Payment[]                    @relation("PaymentUpdatedBy")
  vendorsCreated              Vendor[]                    @relation("VendorCreatedBy")
  vendorsUpdated              Vendor[]                    @relation("VendorUpdatedBy")
  purchaseOrdersOwned         PurchaseOrder[]             @relation("PurchaseOrderOwner")
  purchaseOrdersCreated       PurchaseOrder[]             @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated       PurchaseOrder[]             @relation("PurchaseOrderUpdatedBy")
  goodsReceiptsCreated        GoodsReceipt[]              @relation("GoodsReceiptCreatedBy")
  goodsReceiptsUpdated        GoodsReceipt[]              @relation("GoodsReceiptUpdatedBy")
  vendorBillsOwned            VendorBill[]                @relation("VendorBillOwner")
  vendorBillsCreated          VendorBill[]                @relation("VendorBillCreatedBy")
  vendorBillsUpdated          VendorBill[]                @relation("VendorBillUpdatedBy")
  vendorPaymentsCreated       VendorPayment[]             @relation("VendorPaymentCreatedBy")
  vendorPaymentsUpdated       VendorPayment[]             @relation("VendorPaymentUpdatedBy")
  inventoryMovementsCreated   InventoryMovement[]         @relation("InventoryMovementCreatedBy")

  @@index([status])
  @@map("users")
}

model OrganizationMember {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Roles belong to one organization. Permission codes are global.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(64)
  name           String   @db.VarChar(120)
  description    String?  @db.VarChar(500)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(64)
  action      String   @db.VarChar(32)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Server-side session. The access token stays stateless.
/// Only the SHA-256 hash of the refresh token is stored.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(64)
  module         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([module, entityType, entityId])
  @@index([createdAt, id])
  @@map("audit_logs")
}

model Currency {
  code          String   @id @db.Char(3)
  name          String   @db.VarChar(80)
  symbol        String   @db.VarChar(8)
  decimalPlaces Int      @default(2) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations Organization[]
  customers     Customer[]
  resellers     Reseller[]
  productPrices ProductPrice[]
  opportunities Opportunity[]
  tenders       Tender[]
  leads         Lead[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  payments      Payment[]
  vendors       Vendor[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts GoodsReceipt[]
  vendorBills   VendorBill[]
  vendorPayments VendorPayment[]
  baseRates     ExchangeRate[] @relation("ExchangeRateBase")

  quoteRates    ExchangeRate[] @relation("ExchangeRateQuote")

  @@index([isActive])
  @@map("currencies")
}

model PaymentTerm {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  code               String   @db.VarChar(32)
  name               String   @db.VarChar(100)
  dueDays            Int      @default(0) @map("due_days")
  discountDays       Int      @default(0) @map("discount_days")
  discountPercent    Decimal? @map("discount_percent") @db.Decimal(7, 4)
  requiresPrepayment Boolean  @default(false) @map("requires_prepayment")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  customers    Customer[]
  quotes       Quote[]
  salesOrders  SalesOrder[]
  invoices     Invoice[]
  vendors      Vendor[]
  purchaseOrders PurchaseOrder[]
  vendorBills  VendorBill[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("payment_terms")
}

model CustomerPricingGroup {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  code            String                   @db.VarChar(32)
  name            String                   @db.VarChar(100)
  groupType       CustomerPricingGroupType @map("group_type")
  discountPercent Decimal?                 @map("discount_percent") @db.Decimal(7, 4)
  isActive        Boolean                  @default(true) @map("is_active")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  customers    Customer[]

  @@unique([organizationId, code])
  @@index([organizationId, groupType, isActive])
  @@map("customer_pricing_groups")
}

/// Rate is quote-currency units per 1 base-currency unit.
/// Example: base USD, quote PKR, rate 278.50000000 means 1 USD = 278.50 PKR.
model ExchangeRate {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  baseCurrencyCode  String   @map("base_currency_code") @db.Char(3)
  quoteCurrencyCode String   @map("quote_currency_code") @db.Char(3)
  rate              Decimal  @db.Decimal(19, 8)
  effectiveDate     DateTime @map("effective_date") @db.Date
  source            String   @db.VarChar(80)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id])
  baseCurrency  Currency     @relation("ExchangeRateBase", fields: [baseCurrencyCode], references: [code])
  quoteCurrency Currency     @relation("ExchangeRateQuote", fields: [quoteCurrencyCode], references: [code])

  @@unique([organizationId, baseCurrencyCode, quoteCurrencyCode, effectiveDate])
  @@index([organizationId, baseCurrencyCode, quoteCurrencyCode, effectiveDate])
  @@map("exchange_rates")
}

/// Shared counter for future quotes, orders, invoices, bills, and the other
/// document types. Allocating a number locks this row inside a transaction.
model DocumentSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  documentType   DocumentType @map("document_type")
  prefix         String       @db.VarChar(16)
  nextNumber     Int          @default(1) @map("next_number")
  padding        Int          @default(5)
  year           Int
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, documentType, year])
  @@map("document_sequences")
}

/// Organization-scoped accounting/tax classification (e.g. Local, Regional, Export)
/// that groups customers for revenue and tax posting.
model AccountingCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  customers    Customer[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("accounting_categories")
}

/// Commercial party. Prospects stay on Opportunity until conversion links a customer.
/// Soft-deleted rows stay so later documents can still reference the id.
model Customer {
  id                            String                        @id @default(uuid()) @db.Uuid
  organizationId                String                        @map("organization_id") @db.Uuid
  resellerId                    String?                       @map("reseller_id") @db.Uuid
  customerNumber                String                        @map("customer_number") @db.VarChar(32)
  customerCode                  String?                       @map("customer_code") @db.VarChar(32)
  entityType                    CustomerEntityType            @default(COMPANY) @map("entity_type")
  customerType                  CustomerType                  @map("customer_type")
  customerCategory              CustomerCategory?             @map("customer_category")
  industry                      String?                       @db.VarChar(120)
  employeeCount                 Int?                          @map("employee_count")
  incorporationStatus           CustomerIncorporationStatus?  @map("incorporation_status")
  businessRegistrationDate      DateTime?                     @map("business_registration_date") @db.Date
  registrationNumber            String?                       @map("registration_number") @db.VarChar(64)
  rating                        CustomerRating?               @map("rating")
  priority                      CustomerPriority              @default(NORMAL) @map("priority")
  sameAsBilling                 Boolean                       @default(true) @map("same_as_billing")
  leadSource                    CustomerLeadSource?           @map("lead_source")
  assignedSalesRepId            String?                       @map("assigned_sales_rep_id") @db.Uuid
  legalName                     String                        @map("legal_name") @db.VarChar(200)
  displayName                   String                        @map("display_name") @db.VarChar(200)
  middleName                    String?                       @map("middle_name") @db.VarChar(100)
  email                         String?                       @db.VarChar(320)
  phone                         String?                       @db.VarChar(40)
  website                       String?                       @db.VarChar(200)
  countryCode                   String                        @map("country_code") @db.Char(2)
  currencyCode                  String                        @map("currency_code") @db.Char(3)
  taxNumber                     String?                       @map("tax_number") @db.VarChar(64)
  taxIdType                     CustomerTaxIdType?            @map("tax_id_type")
  taxExemptionCode              String?                       @map("tax_exemption_code") @db.VarChar(64)
  defaultTaxCodeId              String?                       @map("default_tax_code_id") @db.Uuid
  identityDocumentType          CustomerIdentityDocumentType? @map("identity_document_type")
  identityDocumentNumber        String?                       @map("identity_document_number") @db.VarChar(40)
  status                        CustomerStatus                @default(ACTIVE)
  taxExempt                     Boolean                       @default(false) @map("tax_exempt")
  pricesIncludeTax              Boolean                       @default(false) @map("prices_include_tax")
  emailMarketingOptIn           Boolean                       @default(false) @map("email_marketing_opt_in")
  creditHold                    Boolean                       @default(false) @map("credit_hold")
  creditLimit                   Decimal                       @default(0) @map("credit_limit") @db.Decimal(19, 4)
  preferredPaymentMethod        CustomerPaymentMethod?        @map("preferred_payment_method")
  preferredCommunicationChannel CustomerCommunicationChannel? @map("preferred_communication_channel")
  paymentTermId                 String?                       @map("payment_term_id") @db.Uuid
  pricingGroupId                String?                       @map("pricing_group_id") @db.Uuid
  accountingCategoryId          String?                       @map("accounting_category_id") @db.Uuid
  openingBalance                Decimal                       @default(0) @map("opening_balance") @db.Decimal(19, 4)
  openingBalanceDate            DateTime?                     @map("opening_balance_date") @db.Date
  notes                         String?                       @db.VarChar(4000)
  createdById                   String                        @map("created_by_id") @db.Uuid
  updatedById                   String                        @map("updated_by_id") @db.Uuid
  deletedAt                     DateTime?                     @map("deleted_at") @db.Timestamptz(6)
  createdAt                     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization            @relation(fields: [organizationId], references: [id])
  reseller           Reseller?               @relation(fields: [resellerId], references: [id])
  currency           Currency                @relation(fields: [currencyCode], references: [code])
  createdBy          User                    @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy          User                    @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  assignedSalesRep   User?                   @relation("CustomerSalesRep", fields: [assignedSalesRepId], references: [id])
  paymentTerm        PaymentTerm?            @relation(fields: [paymentTermId], references: [id])
  pricingGroup       CustomerPricingGroup?   @relation(fields: [pricingGroupId], references: [id])
  accountingCategory AccountingCategory?     @relation(fields: [accountingCategoryId], references: [id])
  defaultTaxCode     TaxCode?                @relation("CustomerDefaultTaxCode", fields: [defaultTaxCodeId], references: [id], onDelete: SetNull)
  addresses          CustomerAddress[]
  contacts           Contact[]
  customerNotes      CustomerNote[]
  activities         CustomerActivity[]
  supportTickets     CustomerSupportTicket[]
  documents          CustomerDocument[]
  opportunities      Opportunity[]
  tenders            Tender[]
  convertedLeads     Lead[]                  @relation("LeadConvertedCustomer")
  quotes             Quote[]
  salesOrders        SalesOrder[]
  invoices           Invoice[]
  payments           Payment[]

  @@unique([organizationId, customerCode])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerType, createdAt])
  @@index([organizationId, countryCode, createdAt])
  @@index([organizationId, currencyCode])
  @@index([organizationId, resellerId, createdAt])
  @@index([organizationId, assignedSalesRepId, status])
  @@index([organizationId, paymentTermId])
  @@index([organizationId, pricingGroupId])
  @@index([organizationId, accountingCategoryId])
  @@map("customers")
}

