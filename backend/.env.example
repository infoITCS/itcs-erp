NODE_ENV=development
PORT=4000

# PostgreSQL 18. Runtime pool. This may later point at PgBouncer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_db
# Direct primary URL used by Prisma Migrate.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/erp_db
DATABASE_POOL_MAX=10

# Optional. When set, the reports read client uses this URL (a replica).
# READ_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_db

# Replace these before any shared or production deployment. Minimum 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-32b
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-32
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
DEFAULT_ORGANIZATION_CODE=ITCS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
TRUST_PROXY=false

# Microsoft Entra ID (single tenant). Leave blank to hide SSO on the login screen.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/auth/microsoft/callback
MICROSOFT_ALLOWED_DOMAIN=itcs.com.pk
MICROSOFT_AUTO_PROVISION=true
MICROSOFT_DEFAULT_ROLE=viewer

# Used only by prisma/seed.ts. Never commit a real password.
ADMIN_EMAIL=admin@itcs.local
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_PASSWORD=
