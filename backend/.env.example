NODE_ENV=development
PORT=4000

# PostgreSQL 18. Runtime pool. This may later point at PgBouncer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itcs_erp
# Direct primary URL used by Prisma Migrate.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/itcs_erp
DATABASE_POOL_MAX=10

# Optional. When set, the reports read client uses this URL (a replica).
# READ_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itcs_erp

# Replace these before any shared or production deployment. Minimum 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-32b
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-32
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
TRUST_PROXY=false

# Used only by prisma/seed.ts. Never commit a real password.
ADMIN_EMAIL=admin@itcs.local
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_PASSWORD=
