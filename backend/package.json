{
  "name": "itcs-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "ITCS ERP API — modular monolith scaffold",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ./node_modules/prisma/build/index.js generate && node dist/server.js",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "test": "tsx --test tests/api.test.ts tests/auth.test.ts tests/auth-service.test.ts tests/audit.test.ts tests/currency.test.ts tests/customers.test.ts tests/products.test.ts tests/resellers.test.ts tests/opportunities.test.ts tests/tenders.test.ts tests/document-number.test.ts tests/pagination.test.ts tests/microsoft.test.ts tests/users.test.ts tests/request-logger.test.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
